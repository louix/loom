{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-nested-ternary": "error",
    "default-case-last": "error",
    "no-lonely-if": "error",
    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "prefer-arrow-callback": "error"
  },
  "env": {
    "builtin": true
  }
}
