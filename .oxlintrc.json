{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-nested-ternary": "error",
    "default-case-last": "error",
    "no-lonely-if": "error"
  },
  "env": {
    "builtin": true
  }
}
