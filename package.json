{
  "name": "loom-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Workspace root for loom — see cli/ for the app package.",
  "type": "module",
  "scripts": {
    "loom": "oxnode --import ./cli/src/oxc-esm-fixup.mjs cli/src/loom.ts",
    "daemon": "oxnode cli/src/loomd.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:silent": "pnpm exec tsc --noEmit",
    "watch": "tsc --noEmit --watch",
    "test": "node --import @oxc-node/core/register --test \"test/*.test.ts\"",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@loom/aisdk": "workspace:*",
    "@loom/client": "workspace:*",
    "@loom/connector-claude": "workspace:*",
    "@loom/connector-gemini": "workspace:*",
    "@loom/connector-generic": "workspace:*",
    "@loom/connector-mock": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/daemon": "workspace:*",
    "@loom/harness": "workspace:*",
    "@loom/tui": "workspace:*",
    "@oxc-node/cli": "0.1.0",
    "@oxc-node/core": "0.1.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "ai": "5.0.249",
    "ink": "7.1.1",
    "loom": "workspace:*",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "react": "19.2.8",
    "smol-toml": "1.8.0",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.24.0"
}
