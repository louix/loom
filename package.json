{
  "name": "loom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Per-project daemon that runs and supervises a fleet of coding agents, each in its own git worktree.",
  "bin": {
    "loom": "./src/cli/loom.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "loom": "node src/cli/loom.ts",
    "daemon": "node src/cli/loomd.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
