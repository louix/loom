{
  "nodeModulesDir": "auto",
  "workspace": [
    "core",
    "client",
    "aisdk",
    "runtime",
    "harness",
    "backend/daemon",
    "frontend/tui",
    "connectors/generic",
    "connectors/claude",
    "connectors/gemini",
    "connectors/mock",
    "connectors/chatgpt",
    "cli"
  ],
  "imports": {
    "zod": "npm:zod@4.5.4",
    "ai": "npm:ai@7.0.85",
    "ink": "npm:ink@7.1.1",
    "react": "npm:react@19.2.8",
    "@ai-sdk/mcp": "npm:@ai-sdk/mcp@2.0.41",
    "@ai-sdk/provider": "npm:@ai-sdk/provider@4.0.9",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@4.0.46",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@3.0.41",
    "@ai-sdk/google": "npm:@ai-sdk/google@4.0.58",
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.251",
    "smol-toml": "npm:smol-toml@1.8.0",
    "oxlint": "npm:oxlint@1.80.0",
    "oxfmt": "npm:oxfmt@0.65.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "tasks": {
    "runtime:hashes": "deno run -A scripts/update-runtime-hashes.ts",
    "runtime:update": "deno run -A cli/src/loom.ts runtime update",
    "loom": "deno run -A --deny-net cli/src/loom.ts",
    "daemon": "deno run -A --deny-net cli/src/loomd.ts",
    "typecheck": "deno check core client aisdk runtime harness backend/daemon frontend/tui connectors/generic connectors/claude connectors/gemini connectors/mock connectors/chatgpt cli scripts test",
    "typecheck:silent": "deno task typecheck",
    "watch": "deno task typecheck --watch",
    "test": "NO_COLOR=1 deno test -A test/",
    "test:silent": "NO_COLOR=1 deno run -A scripts/fail-only-reporter.ts test/",
    "test:timing": "NO_COLOR=1 deno run -A scripts/timing-reporter.ts test/",
    "lint": "deno run -A npm:oxlint@1.80.0 .",
    "format": "deno run -A npm:oxfmt@0.65.0 .",
    "format:check": "deno run -A npm:oxfmt@0.65.0 --check ."
  }
}
