{
  "nodeModulesDir": "auto",
  "workspace": [
    "core",
    "client",
    "aisdk",
    "runtime",
    "isolation",
    "environment-config",
    "harness",
    "backend/daemon",
    "frontend/tui",
    "connectors/generic",
    "connectors/claude",
    "connectors/gemini",
    "connectors/mock",
    "connectors/echo",
    "connectors/chatgpt",
    "cli"
  ],
  "imports": {
    "jsonc-parser": "npm:jsonc-parser@3.3.1",
    "oauth4webapi": "npm:oauth4webapi@3.8.8",
    "zod": "npm:zod@4.6.7",
    "ai": "npm:ai@7.0.164",
    "ink": "npm:ink@7.1.1",
    "react": "npm:react@19.3.1",
    "@types/react": "npm:@types/react@19.3.0",
    "marked": "npm:marked@18.1.3",
    "micromark": "npm:micromark@4.0.3",
    "micromark-util-decode-string": "npm:micromark-util-decode-string@2.0.1",
    "entities": "npm:entities@9.0.0",
    "lowlight": "npm:lowlight@3.3.0",
    "string-width": "npm:string-width@8.3.0",
    "@ai-sdk/mcp": "npm:@ai-sdk/mcp@2.0.92",
    "@ai-sdk/provider": "npm:@ai-sdk/provider@4.0.36",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@4.0.98",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@3.0.86",
    "@ai-sdk/google": "npm:@ai-sdk/google@4.0.113",
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.319",
    "oxlint": "npm:oxlint@1.92.0",
    "oxfmt": "npm:oxfmt@0.77.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "tasks": {
    "config:schema": "deno run -A scripts/config-schema.ts && deno run -A npm:oxfmt@0.77.0 backend/daemon/config.schema.json environment-config/*.schema.json",
    "runtime:hashes": "deno run -A scripts/update-runtime-hashes.ts",
    "runtime:guest-source": "deno run -A scripts/guest-source.ts",
    "runtime:update": "deno run -A cli/src/loom.ts runtime update",
    "loom": "deno run -A --deny-net cli/src/loom.ts",
    "daemon": "deno run -A --deny-net cli/src/loomd.ts",
    "isolate": "deno run -A --deny-net cli/src/loom-isolate.ts",
    "typecheck": "deno check core client aisdk runtime isolation environment-config harness backend/daemon frontend/tui connectors/generic connectors/claude connectors/gemini connectors/mock connectors/echo connectors/chatgpt cli scripts test",
    "typecheck:silent": "deno task typecheck",
    "watch": "deno task typecheck --watch",
    "test": "NO_COLOR=1 deno run -A scripts/test.ts",
    "test:silent": "NO_COLOR=1 deno run -A scripts/fail-only-reporter.ts",
    "test:timing": "NO_COLOR=1 deno run -A scripts/timing-reporter.ts",
    "lint": "deno run -A npm:oxlint@1.92.0 .",
    "format": "deno run -A npm:oxfmt@0.77.0 --no-error-on-unmatched-pattern .",
    "format:check": "deno run -A npm:oxfmt@0.77.0 --check --no-error-on-unmatched-pattern .",
    "prepare": "git config core.hooksPath .githooks"
  }
}
