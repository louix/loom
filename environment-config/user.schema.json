                  }
                },
                "required": ["auto"],
                "additionalProperties": false
              },
              "commandPrefix": {
                "description": "Literal argv that wraps activation; an alternative to nix.auto.",
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                }
              },
              "timeoutSeconds": {
                "description": "Activation timeout.",
                "type": "integer",
                "minimum": 1,
                "maximum": 2073600
              },
              "resources": {
                "type": "object",
                "properties": {
                  "cpus": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "minimum": 512,
                    "maximum": 65536
                  }
                },
                "additionalProperties": false
              },
              "prepare": {
                "description": "Workspace preparation hooks. Replaces any earlier layer's list.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536
                    },
                    "run": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536,
                      "description": "Shell command run in the guest workspace."
                    },
                    "timeoutSeconds": {
                      "default": 900,
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600
                    }
                  },
                  "required": ["run"],
                  "additionalProperties": false
                }
              },
              "start": {
                "description": "Hooks run before each start becomes available. Replaces any earlier layer's list.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536
                    },
                    "run": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536,
                      "description": "Shell command run in the guest workspace."
                    },
                    "timeoutSeconds": {
                      "default": 900,
