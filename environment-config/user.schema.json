              }
            },
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "properties": {
              "network": {
                "type": "object",
                "properties": {
                  "presets": {
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["nix", "javascript", "python", "rust"]
                    }
                  },
                  "allowedHosts": {
