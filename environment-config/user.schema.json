                    }
                  },
                  "hosts": {
                    "deprecated": true,
                    "description": "Replaced by allowedHosts.",
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "Network the host applies directly, without a project request."
          },
          "lifecycle": {
            "type": "object",
            "properties": {
              "workspace": {
                "type": "string",
                "enum": ["in-place", "worktree", "clone"]
              },
              "execution": {
                "type": "string",
                "enum": ["vm", "local"]
              },
              "idleTimeoutMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "additionalProperties": false
          },
          "grants": {
            "default": {},
            "type": "object",
            "properties": {
              "setup": {
                "default": false,
                "description": "Let the project request nix.auto, commandPrefix, prepare and start hooks.",
                "type": "boolean"
              },
              "network": {
                "description": "Hosts the project may request.",
                "type": "object",
