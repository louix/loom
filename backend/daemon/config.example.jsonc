// ~/.config/loom/config.jsonc, or $XDG_CONFIG_HOME/loom/config.jsonc.
// Comments and trailing commas are supported. Repository-local files are not read.
{
  "$schema": "./config.schema.json",
  "base_branch": "main",
  // Empty uses ~/.local/share/loom/worktrees/<repo>-<hash> (respects XDG_DATA_HOME).
  // Override per repo with an absolute, ~/ or repo-relative directory.
  "worktree_dir": "",
  "daemon": { "idle_shutdown_minutes": 30 },
  // Include the event log as a second file on Alt+E (Vim/Neovim may need :wq!).
  "tui": { "include_event_log_in_editor": false },
  "providers": {
    "claude": {
      "permission_default": "manual",
      // "cli_path": "/path/to/claude",
      // "title_model": "haiku",
      // Omit profiles to use ~/.claude. Named accounts appear as claude:work, etc.
      // tag sets the display label without changing the provider id.
      // A family-level tag is inherited unless a profile overrides it.
      // "profiles": {
      //   "work": { "config_dir": "~/.claude-work", "tag": "Work Claude", "color": "yellow" },
      //   "personal": { "config_dir": "~/.claude-personal" },
      // },
    },
    "codex": {
      // Uses the account authenticated by codex login; discovers available models.
      // Family settings are inherited by every profile.
      // "cli_path": "/path/to/codex",
      // "builtin_web_search": true,
      // "profiles": {
      //   "default": { "config_dir": "~/.codex" }, // provider id: codex
      //   "work": { "config_dir": "~/.codex-work", "tag": "Work Codex", "color": "cyan" }, // codex:work
      // },
    },
    // Native API families follow the same pattern; require a model and credentials.
    // "google": { "api_key_env": "GEMINI_API_KEY", "model": "gemini-2.5-pro" },
    // "anthropic": { "api_key_env": "ANTHROPIC_API_KEY", "model": "claude-sonnet-5" },
    // Endpoint profile names are their provider ids (here, "local").
    // "openai_compatible": {
    //   "profiles": {
    //     "local": { "base_url": "http://localhost:11434/v1", "title_model": "qwen3" },
    //   },
    // },
  },
  "session": {
    // Allow project shell activation (devenv, flake.nix, shell.nix, default.nix).
    "auto_nix": false, // opt in globally or for individual repos
    "worktree": { "enabled": true },
    "isolation": { "enabled": false }, // VM execution; independent of worktrees
    "auto_rebase": { "enabled": false, "mode": "rebase" }, // or merge
    "auto_resume": { "enabled": true },
    "commit_reminder": { "enabled": true },
    "titles": { "enabled": true }, // title_model belongs to each provider
    "notify": { "webhook": "" },
    "local_tools": [],
    "vm_tools": [],
    "remote_tools": [],
  },
  // Definitions are inert until selected in session.local_tools/vm_tools/remote_tools.
  "local_tools": {
    "tilth": {
      "command": "tilth",
      "args": ["--mcp", "--edit"],
      "default_for": ["read", "write", "edit"],
    },
  },
  "vm_tools": {
    "tilth": { "runtime": "tilth", "default_for": ["read", "write", "edit", "find", "grep"] },
  },
  // "remote_tools": {
  //   "kagi": { "url": "https://mcp.kagi.com/mcp", "bearer_token_env": "KAGI_API_KEY", "default_for": ["web_search", "web_fetch"] },
  // },
  "hooks": [],
  // Objects merge recursively; arrays replace inherited arrays, except hooks:
  // repo hooks append to global hooks (an empty array still inherits globals).
  "repos": [
    // {
    //   "path": "~/dev/my-project",
    //   "worktree_dir": "/mnt/fast-drive/loom/my-project",
    //   "session": {
    //     "auto_nix": true,
    //     "isolation": { "enabled": true, "network_presets": ["nix", "javascript"] },
    //     "vm_tools": ["tilth"],
    //     "provider_access": { "only": ["claude:work"] },
    //   },
    //   "hooks": [{ "on": "init", "run": "deno install --frozen", "timeout": 600 }],
    // },
  ],
}
